# Supabase (already provisioned — fill in .env.local, never commit real values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Custom auth (own users table, not Supabase Auth)
SESSION_COOKIE_SECRET=   # random 32+ byte string, used to sign/verify session cookie
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=         # optional, defaults to SMTP_USER if unset

# Inngest (background scrape jobs)
# For local dev: run `npm run dev:inngest` (starts the Inngest Dev Server) alongside `npm run dev`,
# and leave these as-is — "local" works against the Dev Server with no account needed.
# For production: replace with real keys from an Inngest account and remove INNGEST_DEV.
INNGEST_DEV=1
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=

# reCAPTCHA (login form)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firecrawl (used by the job runner to fetch search-engine result pages)
FIRECRAWL_API_KEY=

# Phase 2+: Apify (not needed for Phase 1)
# APIFY_API_TOKEN=
